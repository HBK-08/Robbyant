# Keep deployment scripts and dependency records, not downloaded environments.
/deployment/*/*
!/deployment/*/*.sh
!/deployment/*/*.py
!/deployment/*/*.diff
!/deployment/*/*.sha256
!/deployment/*/constraints.txt
!/deployment/*/official-final-pins.txt
!/deployment/*/prefetch-requirements.txt
!/deployment/*/conda-explicit.txt
!/deployment/*/pip-freeze.txt
/deployment/*/*-before-official-patch.py

# Local credentials
.env
.env.*
!.env.example
*.pem
*.key

# Generated datasets, model weights, and outputs at the workspace root
